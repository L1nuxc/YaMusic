# Copy to .env in the project root. No API keys are needed for stages 1-3.
BIND_ADDRESS=127.0.0.1:8000
DATABASE_URL=sqlite://data/yamusic.db
CLIENT_DIST=client/dist
AUDIO_CACHE_DIR=data/audio
AUDIO_CACHE_GB=15
# YT_DLP_PATH defaults to .tools/bin/yt-dlp.exe on this Windows checkout,
# or yt-dlp from PATH on Ubuntu.
# YT_DLP_PATH=
RUST_LOG=yamusic_server=info,tower_http=info
ANALYSIS_BACKFILL_LIMIT=200
# CPU analysis files are installed by npm run setup:analysis.
# CLAP_MODEL_PATH=models/clap-audio-int8.onnx
# ORT_DYLIB_PATH=
# Telegram Login widget (keep token server-side)
# PUBLIC_ORIGIN=https://yamusic.example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# AUDIO_FOREGROUND_WORKERS=1
# AUDIO_BACKGROUND_WORKERS=1
# Later stages (not read by the current server):
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# AUDIO_CACHE_GB=15
