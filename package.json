    "check": "npm run check --workspace client",
    "test": "node --test client/tests/*.test.ts",
    "server": "node scripts/rust.mjs run",
    "test:backend": "node scripts/rust.mjs test",
    "setup:analysis": "node scripts/setup-analysis.mjs",
    "build:windows": "node scripts/windows.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
