{
  "name": "yamusic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev --workspace client",
