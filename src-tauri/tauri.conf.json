{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YaMusic",
  "mainBinaryName": "YaMusic",
  "version": "0.1.0",
  "identifier": "xyz.pigboss.yamusic",
  "build": {
    "frontendDist": "https://yamusic.pigboss.xyz/"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
